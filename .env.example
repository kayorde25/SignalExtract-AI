# SignalExtract AI - example environment
# Copy to .env and edit as needed.

# Backend
APP_NAME="SignalExtract AI"
API_V1_PREFIX="/api/v1"
LOG_LEVEL="INFO"
DATABASE_URL="sqlite:///./signalextract.db"
STORAGE_DIR="./storage"
REVIEW_THRESHOLD="0.7"
MAX_UPLOAD_MB="25"
ALLOWED_EXTENSIONS=".txt,.pdf,.docx,.eml"

# CORS
# Use "*" only for local dev.
CORS_ALLOW_ORIGINS="*"

# Optional API key protection
REQUIRE_API_KEY="false"
API_KEY=""

# Extraction mode
# - rule_based: deterministic baseline
# - llm: LLM-only (falls back to rule_based if not configured)
# - hybrid: union(llm, rule_based)
EXTRACTION_MODE="rule_based"

# LLM (optional — set EXTRACTION_MODE=llm or hybrid to activate)
# Supports Anthropic Claude models (e.g. claude-haiku-4-5-20251001, claude-sonnet-4-6)
LLM_API_KEY=""
LLM_MODEL="claude-haiku-4-5-20251001"

# Web frontend (Next.js)
# Server-side: used by Next.js API routes to proxy to FastAPI
BACKEND_BASE_URL="http://localhost:8000"
# Client-side: leave empty to use Next.js proxy (recommended)
# NEXT_PUBLIC_API_BASE="/api"
