# SignalExtract AI - example environment
# Copy to .env and edit as needed.

# Backend
APP_NAME="SignalExtract AI"
API_V1_PREFIX="/api/v1"
LOG_LEVEL="INFO"
DATABASE_URL="sqlite:///./signalextract.db"
REVIEW_THRESHOLD="0.7"

# File storage backend: local | gcs | s3
# local is ephemeral on Cloud Run — use a bucket in production.
STORAGE_TYPE="local"
STORAGE_DIR="./storage"                      # local backend only
# STORAGE_BUCKET="signalextract-uploads"     # gcs / s3 bucket name
# STORAGE_PREFIX="uploads/"                   # optional object-key prefix
# S3_ENDPOINT_URL=""                          # S3-compatible only (R2, MinIO); blank for AWS
# S3_REGION="us-east-1"
MAX_UPLOAD_MB="25"
ALLOWED_EXTENSIONS=".txt,.pdf,.docx,.eml"

# CORS — comma-separated allowed origins.
# Local dev:
CORS_ALLOW_ORIGINS="*"
# Production (Vercel frontend):
# CORS_ALLOW_ORIGINS="https://signalextract-ai.com,https://www.signalextract-ai.com"

# Optional API key protection
REQUIRE_API_KEY="false"
API_KEY=""

# Extraction mode
# - rule_based: deterministic baseline
# - llm: LLM-only (falls back to rule_based if not configured)
# - hybrid: union(llm, rule_based)
EXTRACTION_MODE="rule_based"

# LLM (optional — set EXTRACTION_MODE=llm or hybrid to activate)
# Providers: ollama (local or Ollama Cloud) | anthropic
LLM_PROVIDER="ollama"
LLM_ENDPOINT="http://localhost:11434"      # Ollama Cloud: https://ollama.com
LLM_MODEL="llama3.1"                         # Cloud example: gpt-oss:120b-cloud
LLM_API_KEY=""                               # required for Ollama Cloud / Anthropic

# Web frontend (Next.js)
# Server-side: used by Next.js API routes to proxy to FastAPI
# Local: http://localhost:8000  —  Production: https://api.signalextract-ai.com
BACKEND_BASE_URL="http://localhost:8000"
# Client-side: leave empty to use Next.js proxy (recommended)
# NEXT_PUBLIC_API_BASE="/api"
