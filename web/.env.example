# Web (Next.js) environment — server-side only, set these in Vercel → Project → Settings → Environment Variables.
# The Next.js API routes proxy to the FastAPI backend and inject the API key; nothing here is exposed to the browser.

# FastAPI backend base URL
#   Local dev:   http://localhost:8000
#   Production:  https://api.signalextract-ai.com
BACKEND_BASE_URL="http://localhost:8000"

# API key forwarded to the backend (must match the backend's API_KEY when REQUIRE_API_KEY=true)
API_KEY=""
