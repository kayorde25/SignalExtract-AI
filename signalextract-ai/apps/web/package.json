{
  "name": "signalextract-ai-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "axios": "^0.21.1"
  },
  "devDependencies": {
    "typescript": "^4.3.2",
    "webpack": "^5.38.1",
    "webpack-cli": "^4.7.0",
    "jest": "^26.6.0",
    "eslint": "^7.24.0",
    "prettier": "^2.2.1"
  },
  "eslintConfig": {
    "extends": "eslint:recommended",
    "parser": "@typescript-eslint/parser",
    "plugins": ["@typescript-eslint"],
    "rules": {
      "no-unused-vars": "warn",
      "quotes": ["error", "single"]
    }
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node"
  }
}